####################################
# Coindistro Backend Environment
####################################
# Copy this file to .env and adjust values as needed.
# For Render deployment, set these as environment variables.

# ─── Application ───────────────────────────────────────
COINDISTRO_ENV=development
COINDISTRO_DEBUG=true
COINDISTRO_PORT=8080

# ─── Database (PostgreSQL) ─────────────────────────────
COINDISTRO_DB_HOST=localhost
COINDISTRO_DB_PORT=5432
COINDISTRO_DB_USER=coindistro
COINDISTRO_DB_PASSWORD=coindistro
COINDISTRO_DB_NAME=coindistro
COINDISTRO_DB_SSLMODE=disable

# ─── Redis ─────────────────────────────────────────────
COINDISTRO_REDIS_HOST=localhost
COINDISTRO_REDIS_PORT=6379
COINDISTRO_REDIS_PASSWORD=coindistro

# ─── JWT Authentication ────────────────────────────────
COINDISTRO_JWT_ACCESS_SECRET=change-me-in-production
COINDISTRO_JWT_REFRESH_SECRET=change-me-in-production-too
# TTL accepts pure minutes (15, 10080) or Go durations (15m, 168h).
# Pure numbers are interpreted as minutes. Prefer 168h over 7d (Go has no "d").
COINDISTRO_JWT_ACCESS_TTL=15m
COINDISTRO_JWT_REFRESH_TTL=168h

# ─── Logging ───────────────────────────────────────────
COINDISTRO_LOG_LEVEL=debug

# ─── Demo seed accounts (auto after migrations) ───────
# Development: defaults to true. Set false to skip.
# Production: never runs unless COINDISTRO_ALLOW_PRODUCTION_DEMO_USERS=true.
COINDISTRO_SEED_DEMO_USERS=true
# COINDISTRO_ALLOW_PRODUCTION_DEMO_USERS=false
# FORCE_SEED_PASSWORDS=false
# COINDISTRO_SUPER_ADMIN_PASSWORD=Admin123!

# ─── CORS (comma-separated origins) ────────────────────
COINDISTRO_ALLOWED_ORIGINS=http://localhost:3000
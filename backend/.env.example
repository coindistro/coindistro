####################################
# Coindistro Backend Environment
####################################
# Copy this file to .env and adjust values as needed.
# For Render deployment, set these as environment variables.

# ─── Application ───────────────────────────────────────
COINDISTRO_ENV=development
COINDISTRO_DEBUG=true
COINDISTRO_PORT=8080

# ─── Database (PostgreSQL) ─────────────────────────────
COINDISTRO_DB_HOST=localhost
COINDISTRO_DB_PORT=5432
COINDISTRO_DB_USER=coindistro
COINDISTRO_DB_PASSWORD=coindistro
COINDISTRO_DB_NAME=coindistro
COINDISTRO_DB_SSLMODE=disable

# ─── Redis ─────────────────────────────────────────────
COINDISTRO_REDIS_HOST=localhost
COINDISTRO_REDIS_PORT=6379
COINDISTRO_REDIS_PASSWORD=coindistro

# ─── JWT Authentication ────────────────────────────────
COINDISTRO_JWT_ACCESS_SECRET=change-me-in-production
COINDISTRO_JWT_REFRESH_SECRET=change-me-in-production-too
# TTL accepts pure minutes (15, 10080) or Go durations (15m, 168h).
# Pure numbers are interpreted as minutes. Prefer 168h over 7d (Go has no "d").
COINDISTRO_JWT_ACCESS_TTL=15m
COINDISTRO_JWT_REFRESH_TTL=168h

# ─── Logging ───────────────────────────────────────────
COINDISTRO_LOG_LEVEL=debug

# ─── Demo seed accounts (auto after migrations) ───────
# Development: defaults to true. Set false to skip.
# Production: never runs unless COINDISTRO_ALLOW_PRODUCTION_DEMO_USERS=true.
COINDISTRO_SEED_DEMO_USERS=true
# COINDISTRO_ALLOW_PRODUCTION_DEMO_USERS=false
# FORCE_SEED_PASSWORDS=false
# COINDISTRO_SUPER_ADMIN_PASSWORD=Admin123!

# ─── Payment Gateways (Paystack / Flutterwave) ─────────
# Required for /api/v1/investments/paystack/init and earnings payment routes.
# If PAYSTACK_SECRET_KEY is empty, payment init returns 503 GATEWAY_NOT_CONFIGURED.
#
# Paystack credentials are read EXCLUSIVELY from these env vars so switching
# from PurpleSoftHub (dev) to a future CoinDistro Paystack account only requires
# changing values — no code changes.
#
# Set them in the Go backend runtime (Render, docker-compose, or .env).
# Do NOT put the secret key in the Next.js frontend.
#
# Dev: use the PurpleSoftHub Paystack keys.
# Prod (future): replace with CoinDistro Paystack keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Browser return URL after checkout (e.g. https://app.coindistro.com/app/earn)
PAYSTACK_CALLBACK_URL=
# HMAC secret for x-paystack-signature on webhooks. Defaults to PAYSTACK_SECRET_KEY
# when empty (Paystack's standard behaviour).
PAYSTACK_WEBHOOK_SECRET=
#
# Frontend (optional): only if you need Paystack Inline/Popup.
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY should mirror PAYSTACK_PUBLIC_KEY.
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
#
# Flutterwave (optional alternate gateway)
COINDISTRO_FLUTTERWAVE_SECRET_KEY=
COINDISTRO_FLUTTERWAVE_PUBLIC_KEY=
# Flutterwave webhook verification hash (from dashboard settings)
COINDISTRO_FLUTTERWAVE_SECRET_HASH=

# ─── CORS (comma-separated origins) ────────────────────
COINDISTRO_ALLOWED_ORIGINS=http://localhost:3000
